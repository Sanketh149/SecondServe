APP_NAME="SecondServe API"
ENVIRONMENT=local
FRONTEND_ORIGIN=http://localhost:5173

# Local seeded identity headers are for development only.
DEMO_MODE=true

# Set a Google Cloud project and authenticate with Application Default Credentials
# to enable Vertex AI Gemini. Without a project configured, image analysis returns
# an explicit unavailable error and the donor can continue with manual entry.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Optional. Without this in demo mode, route estimates are explicitly synthetic.
GOOGLE_MAPS_API_KEY=
OFFER_TTL_MINUTES=5
MAX_UPLOAD_BYTES=5242880

# Required only when DEMO_MODE=false and Cloud Tasks expiry is enabled.
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=secondserve-offers
CLOUD_TASKS_SERVICE_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
