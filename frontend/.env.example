# Local Vite uses its /api proxy to http://127.0.0.1:8000.
# Production Hosting rewrites /api/** to Cloud Run, so leave this blank there.
VITE_API_BASE_URL=

# Copy these public Firebase Web App config values from Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
